rules_version = '2';

// Ambassadeurs UNUSUALL — règles de sécurité Firestore
// - Chaque ambassadeur ne lit que ses propres données.
// - Il crée sa candidature (statut « pending », sans code) et ne peut modifier
//   que ses coordonnées : ni son statut, ni son code, ni ses gains.
// - Les administrateurs (documents admins/{uid}, créés à la main dans la console)
//   lisent tout, valident les candidatures et gèrent le suivi.
// - Les événements Epicure arrivent par Cloud Functions (Admin SDK), jamais par le client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Liens affichés dans l'admin et l'annuaire : http(s) uniquement (jamais javascript:, data:…).
    function isHttpUrl(v) { return v.matches('(?i)^https?://[^ ]+$'); }
    function profileOk(d) {
      return str(d.nom, 2, 100) && str(d.whatsapp, 6, 30) && str(d.ville, 2, 80)
        && str(d.quartier, 2, 80) && str(d.profession, 2, 100)
        && d.reseau is list && d.reseau.size() >= 1 && d.reseau.size() <= 6
        && str(d.profilLien, 4, 300) && isHttpUrl(d.profilLien)
        && str(d.photo, 0, 300) && (d.photo == '' || isHttpUrl(d.photo))
        && str(d.motivation, 80, 2000)
        && d.annuaire is bool
        && d.produits is list && d.produits.size() >= 1 && d.produits.size() <= 10
        && d.produitsFuturs is list && d.produitsFuturs.size() <= 10;
    }
    function allowedKeys() {
      return ['nom', 'whatsapp', 'email', 'ville', 'quartier', 'profession', 'reseau',
              'profilLien', 'photo', 'motivation', 'annuaire',
              'produits', 'produitsFuturs', 'charte', 'status', 'code', 'createdAt', 'updatedAt'];
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /settings/platform {
      allow read, write: if isAdmin();
    }

    match /ambassadors/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(allowedKeys())
        && profileOk(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        // Adresse e-mail confirmée (lien reçu à l'inscription) : pas de candidature avec l'e-mail d'un autre.
        && request.auth.token.email_verified == true
        && request.resource.data.charte == true
        && request.resource.data.status == 'pending'
        && request.resource.data.code == null
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nom', 'whatsapp', 'ville', 'quartier', 'profession', 'reseau', 'profilLien', 'photo', 'motivation', 'annuaire', 'produits', 'produitsFuturs', 'updatedAt'])
            && profileOk(request.resource.data));

      allow delete: if isAdmin();

      // Suivi Epicure : lu par l'ambassadeur, écrit par l'administration ou les Cloud Functions.
      match /restaurants/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }
      match /payments/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }
      match /commissions/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Clients historiques et versements : lus par l'ambassadeur, écrits par l'administration seulement.
      match /{sub}/{docId} {
        allow read: if (sub == 'clients' || sub == 'payouts') && (isOwner(uid) || isAdmin());
        allow write: if (sub == 'clients' || sub == 'payouts') && isAdmin();
      }
    }

    // Requêtes « collection group » de l'administration (vue d'ensemble, suivi
    // des liens, récapitulatif) : lecture de tous les restaurants / commissions.
    match /{path=**}/restaurants/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/commissions/{docId} {
      allow read: if isAdmin();
    }
  }
}